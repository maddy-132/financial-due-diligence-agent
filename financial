# -------------------------------
# Document Analysis Agent
# -------------------------------
def extract_documents(files):
    documents = []

    for file in files:
        try:
            if file.name.lower().endswith(".pdf"):
                reader = PdfReader(BytesIO(file.getvalue()))
                content = "\n".join(
                    page.extract_text() or "" for page in reader.pages
                )
            else:
                content = file.getvalue().decode(
                    "utf-8", errors="ignore"
                )

            documents.append({
                "source": file.name,
                "text": content
            })
        except Exception as error:
            st.warning(f"Could not read {file.name}: {error}")

    return documents


def retrieve_documents(documents, query):
    if not documents:
        return []

    chunks = []
    for doc in documents:
        # Split long documents into overlapping sections
        words = doc["text"].split()
        for start in range(0, len(words), 150):
            chunk = " ".join(words[start:start + 180])
            if chunk.strip():
                chunks.append({
                    "source": doc["source"],
                    "text": chunk
                })

    if not chunks:
        return []

    texts = [chunk["text"] for chunk in chunks]

    try:
        vectorizer = TfidfVectorizer(
            stop_words="english",
            max_features=5000
        )
        matrix = vectorizer.fit_transform(texts + [query])
        scores = cosine_similarity(
            matrix[-1], matrix[:-1]
        ).flatten()

        ranked = scores.argsort()[::-1][:5]

        return [
            {**chunks[i], "score": float(scores[i])}
            for i in ranked if scores[i] > 0
        ]
    except ValueError:
        return []


# -------------------------------
# Research Agent: Financial Data
# -------------------------------
def get_financial_data(ticker_symbol):
    ticker = yf.Ticker(ticker_symbol)
    info = ticker.info
    history = ticker.history(period="1y")

    financials = {
        "Company": info.get("longName", ticker_symbol),
        "Ticker": ticker_symbol,
        "Sector": info.get("sector", "Unavailable"),
        "Market Capitalization": info.get("marketCap"),
        "Revenue": info.get("totalRevenue"),
        "Net Income": info.get("netIncomeToCommon"),
        "Total Debt": info.get("totalDebt"),
        "Cash": info.get("totalCash"),
        "Profit Margin": info.get("profitMargins"),
        "Debt-to-Equity": info.get("debtToEquity"),
        "Current Ratio": info.get("currentRatio"),
        "Operating Cash Flow": info.get("operatingCashflow"),
        "52-Week High": info.get("fiftyTwoWeekHigh"),
        "52-Week Low": info.get("fiftyTwoWeekLow")
    }

    return financials, history


# -------------------------------
# Research Agent: Public News
# -------------------------------
def get_company_news(company_name):
    query = requests.utils.quote(
        f'"{company_name}" company finance'
    )
    url = (
        "https://news.google.com/rss/search?q="
        + query + "&hl=en-IN&gl=IN&ceid=IN:en"
    )

    feed = feedparser.parse(url)
    articles = []

    for entry in feed.entries[:15]:
        articles.append({
            "Date": entry.get("published", "Unknown"),
            "Headline": entry.get("title", "No title"),
            "Source": entry.get("source", {}).get(
                "title", "News feed"
            ),
            "URL": entry.get("link", "")
        })

    return articles


# -------------------------------
# Synthesis Agent: Risk Analysis
# -------------------------------
def analyze_risks(financials, news, documents):
    risks = []
    warnings = []

    revenue = financials.get("Revenue")
    net_income = financials.get("Net Income")
    debt = financials.get("Total Debt")
    cash = financials.get("Cash")
    margin = financials.get("Profit Margin")
    current_ratio = financials.get("Current Ratio")

    if isinstance(revenue, (int, float)) and revenue < 0:
        risks.append("Negative reported revenue; verify the source data.")

    if isinstance(net_income, (int, float)) and net_income < 0:
        risks.append("Reported net loss: investigate profitability.")

    if isinstance(debt, (int, float)) and isinstance(
        cash, (int, float)
    ) and debt > cash:
        risks.append(
            "Total debt exceeds cash; review liquidity and repayment needs."
        )

    if isinstance(margin, (int, float)) and margin < 0:
        risks.append("Negative profit margin: investigate operating costs.")

    if isinstance(current_ratio, (int, float)) and current_ratio < 1:
        risks.append(
            "Current ratio below 1: short-term liquidity may need review."
        )

    if not risks:
        risks.append(
            "No predefined financial warning was triggered. "
            "This does not mean the company is risk-free."
        )

    # Flag headlines for human review; keywords are not proof of wrongdoing.
    keywords = [
        "fraud", "lawsuit", "investigation", "default",
        "bankruptcy", "penalty", "recall", "probe"
    ]

    flagged_news = []
    for item in news:
        headline = item["Headline"]
        if any(word in headline.lower() for word in keywords):
            flagged_news.append(headline)

    if flagged_news:
        warnings.append(
            "News headlines requiring verification: "
            + "; ".join(flagged_news[:5])
        )

    if documents:
        warnings.append(
            f"{len(documents)} uploaded document(s) available for retrieval."
        )

    return risks, warnings


